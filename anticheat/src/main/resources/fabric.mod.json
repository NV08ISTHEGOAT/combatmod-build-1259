    "client": ["com.example.combatguard.client.CombatGuardClient"]
  },
  "mixins": ["combatguard.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
