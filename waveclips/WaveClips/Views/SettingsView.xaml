<UserControl x:Class="WaveClips.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WaveClips.Controls">
    <DockPanel Margin="26,18,26,0">
        <!-- Section tabs -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <RadioButton x:Name="TabCapture" Style="{StaticResource Chip}" GroupName="SettingsTab" Content="🖥  Capture &amp; Monitor" IsChecked="True" Checked="OnTab" />
            <RadioButton x:Name="TabClipping" Style="{StaticResource Chip}" GroupName="SettingsTab" Content="✂  Clipping" Checked="OnTab" />
            <RadioButton x:Name="TabHotkeys" Style="{StaticResource Chip}" GroupName="SettingsTab" Content="⌨  Hotkeys" Checked="OnTab" />
            <RadioButton x:Name="TabAudio" Style="{StaticResource Chip}" GroupName="SettingsTab" Content="🔊  Audio Tracks" Checked="OnTab" />
            <RadioButton x:Name="TabGeneral" Style="{StaticResource Chip}" GroupName="SettingsTab" Content="⚙  General" Checked="OnTab" />
        </WrapPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,6,26">

                <!-- ================================================= CAPTURE ================================================= -->
                <StackPanel x:Name="CapturePage">
                    <c:WavePanel Header="MONITOR">
                        <c:WavePanel.HeaderContent>
                            <Button Style="{StaticResource GhostButton}" Click="OnRefreshMonitors"><Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="Refresh" VerticalAlignment="Center" /></StackPanel></Button.Content></Button>
                        </c:WavePanel.HeaderContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <c:MonitorPicker x:Name="MonitorPicker" Height="200" SelectedDevice="{Binding MonitorId, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RECORDING" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="MonitorTitle" Style="{StaticResource H2}" FontSize="20" />
                                <TextBlock x:Name="MonitorDetails" Style="{StaticResource Body}" Foreground="{StaticResource Label}" Margin="0,4,0,0" />
                                <TextBlock x:Name="MonitorGpu" Style="{StaticResource Dim}" Margin="0,2,0,14" />
                                <TextBlock Style="{StaticResource Dim}" Text="WaveClips records the whole monitor (fullscreen). Click a monitor on the left to choose it." />
                                <CheckBox Style="{StaticResource Switch}" Content="Show mouse cursor" IsChecked="{Binding CaptureCursor}" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>
                    </c:WavePanel>

                    <c:WavePanel Header="VIDEO QUALITY" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK PRESET" Style="{StaticResource SectionLabel}" />
                            <WrapPanel x:Name="PresetChips" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FRAMES PER SECOND" Style="{StaticResource SectionLabel}" />
                                    <WrapPanel x:Name="FpsChips" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RESOLUTION" Style="{StaticResource SectionLabel}" />
                                    <WrapPanel x:Name="ResChips" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="QUALITY MODE" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                            <WrapPanel x:Name="RateChips" />

                            <StackPanel x:Name="QualityBox" Margin="0,8,0,0">
                                <DockPanel>
                                    <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                                    <TextBlock Text="Quality" Style="{StaticResource Body}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="100" Value="{Binding Quality}" SmallChange="1" LargeChange="5" Margin="0,6,0,0"
                                        ValueChanged="OnQualityChanged" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                                           Text="Constant quality keeps every frame sharp and only uses bits where needed. 70-85 looks great for Minecraft." />
                            </StackPanel>
                            <StackPanel x:Name="BitrateBox" Margin="0,8,0,0">
                                <DockPanel>
                                    <TextBlock x:Name="BitrateValue" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                                    <TextBlock Text="Bitrate" Style="{StaticResource Body}" />
                                </DockPanel>
                                <Slider Minimum="2" Maximum="150" Value="{Binding BitrateMbps}" SmallChange="1" LargeChange="5" Margin="0,6,0,0"
                                        ValueChanged="OnBitrateChanged" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                        </StackPanel>
                    </c:WavePanel>

                    <c:WavePanel Header="ENCODER" Margin="0,16,0,0">
                        <c:WavePanel.HeaderContent>
                            <Button Style="{StaticResource GhostButton}" Click="OnRetestEncoders"><Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="Re-test encoders" VerticalAlignment="Center" /></StackPanel></Button.Content></Button>
                        </c:WavePanel.HeaderContent>
                        <StackPanel>
                            <ComboBox x:Name="EncoderBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnEncoderChanged" MaxWidth="520" HorizontalAlignment="Left" MinWidth="420" />
                            <TextBlock x:Name="EncoderNote" Style="{StaticResource Dim}" Margin="0,6,0,12" />
                            <TextBlock Text="ENCODER SPEED" Style="{StaticResource SectionLabel}" />
                            <WrapPanel x:Name="SpeedChips" />
                            <TextBlock Text="CAPTURE METHOD" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
                            <WrapPanel x:Name="MethodChips" />
                            <TextBlock Style="{StaticResource Dim}" Text="Desktop Duplication grabs frames straight from the GPU (fast). GDI is slower but works on unusual setups. WaveClips falls back automatically if something fails." />
                        </StackPanel>
                    </c:WavePanel>
                </StackPanel>

                <!-- ================================================= CLIPPING ================================================= -->
                <StackPanel x:Name="ClippingPage" Visibility="Collapsed">
                    <c:WavePanel Header="CLIP LENGTH">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ClipLenValue" DockPanel.Dock="Right" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Body}" Text="When you press the clip key, save the last…" VerticalAlignment="Center" />
                            </DockPanel>
                            <Slider Minimum="5" Maximum="300" Value="{Binding ClipSeconds}" Margin="0,8,0,8" ValueChanged="OnClipLenChanged"
                                    IsSnapToTickEnabled="True" TickFrequency="5" />
                            <WrapPanel x:Name="ClipLenChips" />
                        </StackPanel>
                    </c:WavePanel>

                    <c:WavePanel Header="WHEN TO CLIP" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="START THE REPLAY BUFFER" Style="{StaticResource SectionLabel}" />
                            <WrapPanel x:Name="AutoStartChips" />
                            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                                       Text="'When a game is running' uses the games you enable on the Games page (Minecraft is set up already). Recording (start/stop) works in every mode." />
                        </StackPanel>
                    </c:WavePanel>

                    <c:WavePanel Header="SAVE LOCATION" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="CLIPS FOLDER" Style="{StaticResource SectionLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open" Margin="6,0,0,0" Click="OnOpenClipFolder" />
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseClipFolder" />
                                <TextBox Text="{Binding ClipFolder, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                            <CheckBox Style="{StaticResource Switch}" Content="Put clips in a folder per game (e.g. WaveClips\Minecraft)" IsChecked="{Binding OrganizeByGame}" Margin="0,12,0,0" />
                            <TextBlock Text="REPLAY BUFFER FOLDER (temporary video, an SSD is best)" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseBufferFolder" />
                                <TextBox Text="{Binding BufferFolder, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                        </StackPanel>
                    </c:WavePanel>

                    <c:WavePanel Header="NOTIFICATIONS" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" Content="Play a sound when a clip is saved" IsChecked="{Binding ClipSound}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Show an overlay popup on the recorded monitor" IsChecked="{Binding ClipOverlay}" Margin="0,10,0,0" />
                            <TextBlock Text="POPUP POSITION" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                            <WrapPanel x:Name="CornerChips" />
                            <Button Content="Show test popup" HorizontalAlignment="Left" Click="OnTestToast" Margin="0,4,0,0" />
                        </StackPanel>
                    </c:WavePanel>
                </StackPanel>

                <!-- ================================================= HOTKEYS ================================================= -->
                <StackPanel x:Name="HotkeysPage" Visibility="Collapsed">
                    <c:WavePanel Header="HOTKEYS">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,14"
                                       Text="Click a box, then press a key (with Ctrl / Alt / Shift if you like) or a mouse button - Mouse 4, Mouse 5 and middle click work too. Esc cancels, Backspace clears. Hotkeys work while Minecraft is focused." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Save clip" Style="{StaticResource H3}" FontSize="15" />
                                    <TextBlock Text="Saves the replay buffer (last N seconds)" Style="{StaticResource Dim}" />
                                </StackPanel>
                                <c:HotkeyBox Grid.Column="1" HorizontalAlignment="Left" Width="260" Hotkey="{Binding ClipHotkey}" Margin="0,6" />

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="Start / stop recording" Style="{StaticResource H3}" FontSize="15" />
                                    <TextBlock Text="Records until you press it again" Style="{StaticResource Dim}" />
                                </StackPanel>
                                <c:HotkeyBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="260" Hotkey="{Binding RecordHotkey}" Margin="0,6" />

                                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                    <TextBlock Text="Replay buffer on / off" Style="{StaticResource H3}" FontSize="15" />
                                    <TextBlock Text="Pause clipping without opening the app" Style="{StaticResource Dim}" />
                                </StackPanel>
                                <c:HotkeyBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="260" Hotkey="{Binding BufferHotkey}" Margin="0,6" />
                            </Grid>
                        </StackPanel>
                    </c:WavePanel>
                </StackPanel>

                <!-- ================================================= AUDIO ================================================= -->
                <StackPanel x:Name="AudioPage" Visibility="Collapsed">
                    <c:WavePanel Header="SEPARATE AUDIO TRACKS">
                        <c:WavePanel.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="TestAudio" Style="{StaticResource ChipToggle}" Content="🎚  Live test" Margin="0,0,6,0" Click="OnTestAudio" />
                                <Button Content="+  Add track" Click="OnAddTrack" />
                            </StackPanel>
                        </c:WavePanel.HeaderContent>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,12"
                                       Text="Each track becomes its own audio stream inside the clip. 'Game' follows whatever game is detected (e.g. Minecraft); 'App' captures one program only (e.g. Discord) - so your friends' voices and the game never get baked together. Needs Windows 10 (2004) or newer." />
                            <ItemsControl x:Name="TracksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Separator}" BorderThickness="1" Margin="0,0,0,10" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="4" Fill="{Binding Brush}" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" MinWidth="120" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="240" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Config.Enabled}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                  Click="OnTrackToggled" ToolTip="Record this track" />
                                                        <TextBox Grid.Column="1" Text="{Binding Config.Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Track name shown in players and the editor" />
                                                        <ComboBox Grid.Column="3" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Config.Source}" />
                                                    </Grid>
                                                    <DockPanel Margin="0,8,0,0" Visibility="{Binding Config.NeedsApp, Converter={StaticResource BoolToVis}}">
                                                        <Button DockPanel.Dock="Right" Content="Pick app ▾" Margin="8,0,0,0" Click="OnPickApp" Tag="{Binding}" />
                                                        <TextBlock DockPanel.Dock="Left" Text="Program" Style="{StaticResource Dim}" VerticalAlignment="Center" Width="62" />
                                                        <TextBox Text="{Binding Config.AppExe, UpdateSourceTrigger=LostFocus}" ToolTip="Program exe name(s), comma separated" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,8,0,0" Visibility="{Binding Config.NeedsDevice, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock DockPanel.Dock="Left" Text="Device" Style="{StaticResource Dim}" VerticalAlignment="Center" Width="62" />
                                                        <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Config.DeviceId}" />
                                                    </DockPanel>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Volume" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Config.Volume}" SmallChange="0.05" LargeChange="0.1" />
                                                        <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Style="{StaticResource Mono}" Width="44" Margin="8,0" VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="3" Content="In mix" IsChecked="{Binding Config.IncludeInMix}" Margin="8,0,16,0" VerticalAlignment="Center"
                                                                  ToolTip="Include this track in the combined 'Mix' track that normal players play" />
                                                        <c:LevelMeter Grid.Column="4" Height="9" Level="{Binding Level}" Color="{Binding Brush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove track" VerticalAlignment="Top"
                                                        Margin="8,0,0,0" Click="OnRemoveTrack" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </c:WavePanel>

                    <c:WavePanel Header="MIX &amp; SYNC" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MixTrack}"
                                      Content="Add a combined 'Mix' track first (so Discord, browsers and normal players hear everything)" />
                            <TextBlock Text="AUDIO QUALITY" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                            <WrapPanel x:Name="AudioBitrateChips" />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock x:Name="SyncValue" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                                <TextBlock Text="Audio sync offset (only if audio feels early/late)" Style="{StaticResource Body}" />
                            </DockPanel>
                            <Slider Minimum="-500" Maximum="500" Value="{Binding AudioSyncOffsetMs}" SmallChange="5" LargeChange="20" Margin="0,6,0,0"
                                    IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnSyncChanged" />
                        </StackPanel>
                    </c:WavePanel>
                </StackPanel>

                <!-- ================================================= GENERAL ================================================= -->
                <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                    <c:WavePanel Header="FFMPEG (VIDEO ENGINE)">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="FfmpegDot" Width="10" Height="10" VerticalAlignment="Center" />
                                <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Body}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,10"
                                       Text="WaveClips uses FFmpeg to capture and encode. The download build already sits next to WaveClips.exe; otherwise install it here with one click (~100 MB)." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="InstallFfmpeg" Style="{StaticResource AccentButton}" Content="Download &amp; install FFmpeg" Click="OnInstallFfmpeg" />
                                <Button Content="Use my own ffmpeg.exe…" Margin="8,0,0,0" Click="OnBrowseFfmpeg" />
                            </StackPanel>
                            <ProgressBar x:Name="FfmpegProgress" Margin="0,12,0,0" Maximum="1" Visibility="Collapsed" />
                            <TextBlock x:Name="FfmpegProgressText" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                        </StackPanel>
                    </c:WavePanel>

                    <c:WavePanel Header="STARTUP" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" Content="Start WaveClips when Windows starts" IsChecked="{Binding StartWithWindows}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Start minimized to the tray" IsChecked="{Binding StartMinimized}" Margin="0,10,0,0" />
                            <CheckBox Style="{StaticResource Switch}" Content="Closing the window keeps WaveClips running in the tray" IsChecked="{Binding CloseToTray}" Margin="0,10,0,0" />
                        </StackPanel>
                    </c:WavePanel>

                    <c:WavePanel Header="ABOUT" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="WaveClips 1.0 - clipping, recording and editing in the WaveClient style." />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Open log file" Click="OnOpenLog" />
                                <Button Content="Open data folder" Margin="8,0,0,0" Click="OnOpenData" />
                                <Button Content="Quit WaveClips" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OnQuit" />
                            </StackPanel>
                        </StackPanel>
                    </c:WavePanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
