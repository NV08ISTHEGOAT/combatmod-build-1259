<Window x:Class="WaveClips.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaveClips.Controls"
        Title="WaveClips" Width="1320" Height="840" MinWidth="1040" MinHeight="660"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}"
        WindowStartupLocation="CenterScreen" Icon="Assets/waveclips.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource Separator}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================= Sidebar ======================= -->
            <Grid Background="{StaticResource SidebarGradient}">
                <c:WaveBackground x:Name="SideWaves" VerticalAlignment="Bottom" Height="260" Intensity="0.9" />
                <Rectangle Width="1" HorizontalAlignment="Right" Fill="{StaticResource Separator}" />
                <DockPanel>
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,0,26">
                        <Image Source="Assets/waveclips.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WAVECLIPS" FontFamily="{StaticResource HeadingFont}" FontSize="21" Foreground="{StaticResource Accent}"
                                       Effect="{StaticResource Glow}" />
                            <TextBlock Text="by WaveClient" FontSize="10" Foreground="{StaticResource TextDim}" Margin="1,-2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,18">
                        <Border Background="#99071B24" BorderBrush="{StaticResource Separator}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource TextDim}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusLabel" Text="Buffer off" Margin="8,0,0,0" FontFamily="{StaticResource HeadingFont}"
                                               FontSize="12" Foreground="{StaticResource Label}" />
                                </StackPanel>
                                <TextBlock x:Name="GameLabel" Text="No game running" Style="{StaticResource Dim}" FontSize="11" Margin="17,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ClipButton" Style="{StaticResource AccentButton}" Click="OnClip" Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="SAVE CLIP" />
                                <TextBlock x:Name="ClipKeyText" Text="" Opacity="0.7" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RecordButton" Style="{StaticResource DangerButton}" Click="OnRecord" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="RecordText" Text="RECORD" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Home" IsChecked="True" Checked="OnNav" />
                        <RadioButton x:Name="NavClips" Style="{StaticResource NavButton}" Tag="&#xE8B2;" Content="Clips" Checked="OnNav" />
                        <RadioButton x:Name="NavEditor" Style="{StaticResource NavButton}" Tag="&#xE70F;" Content="Editor" Checked="OnNav" />
                        <RadioButton x:Name="NavGames" Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Games" Checked="OnNav" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" Checked="OnNav" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- ======================= Content ======================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <TextBlock x:Name="PageTitle" Text="HOME" FontFamily="{StaticResource HeadingFont}" FontSize="13" Foreground="{StaticResource Label}" />
                        <TextBlock x:Name="RecBadge" Text="  ●  REC 00:00" FontFamily="{StaticResource HeadingFont}" FontSize="13"
                                   Foreground="{StaticResource Danger}" Visibility="Collapsed" Margin="14,0,0,0" Effect="{StaticResource GlowRed}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                        <Button Style="{StaticResource TitleBarButton}" x:Name="MaxButton" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                        <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close (keeps running in the tray)" />
                    </StackPanel>
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Separator}" Opacity="0.6" />
                </Grid>

                <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
