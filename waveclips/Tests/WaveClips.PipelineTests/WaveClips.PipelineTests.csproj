<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the real FFmpeg command lines WaveClips builds (Linux: mkfifo + a static FFmpeg). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../WaveClips/Core/Paths.cs" />
    <Compile Include="../../WaveClips/Core/Log.cs" />
    <Compile Include="../../WaveClips/Core/FFmpeg.cs" />
    <Compile Include="../../WaveClips/Core/MediaProbe.cs" />
    <Compile Include="../../WaveClips/Core/Encoders.cs" />
    <Compile Include="../../WaveClips/Core/SettingsEnums.cs" />
    <Compile Include="../../WaveClips/Core/MonitorInfo.cs" />
    <Compile Include="../../WaveClips/Core/ObservableObject.cs" />
    <Compile Include="../../WaveClips/Editor/EditModel.cs" />
    <Compile Include="../../WaveClips/Editor/ExportBuilder.cs" />
    <Compile Include="../../WaveClips/Capture/SegmentIndex.cs" />
    <Compile Include="../../WaveClips/Capture/ClipWriter.cs" />
    <Compile Include="../../WaveClips/Capture/CaptureArgs.cs" />
  </ItemGroup>
</Project>
